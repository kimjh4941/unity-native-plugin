<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jonghyunkim.nativetoolkit.androidlib">
    <application>
        <!--
            Required for Direct Share (Android 10+).
            Declares ACTION_SEND as a supported intent and references shortcuts.xml
            which contains the <share-target> category matching DirectShareTarget shortcuts.
        -->
        <activity android:name="com.unity3d.player.UnityPlayerGameActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
    </application>
</manifest>
