.top-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(245, 247, 250);
    padding: 24px;
}

/*
 * The menu scrolls when it does not fit (a phone in landscape); when it fits it stays centred as before.
 * Unity 6 puts #unity-content-and-vertical-scroll-container and #unity-content-viewport between the
 * ScrollView and its content container, hence the descendant selector.
 */
.top-scroll {
    flex-grow: 1;
    align-self: stretch;
}

/*
 * The content is as wide as the viewport (inside a ScrollView its width is not tied to the viewport), and the
 * title and the description wrap: at Constant Physical Size (96 DPI) the menu is about 188 wide on an iPhone XS
 * and 170 on a 13 mini, less than the text in one line, which was cut at both sides (2026-11-22).
 */
.top-scroll #unity-content-container {
    flex-grow: 1;
    width: 100%;
    min-height: 100%;
    justify-content: center;
    align-items: center;
}

.top-content {
    width: 100%;
    max-width: 420px;
    padding: 0;
    gap: 12px;
}

.top-title {
    white-space: normal;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(33, 33, 33);
    -unity-text-align: upper-center;
}

.top-subtitle {
    white-space: normal;
    font-size: 13px;
    color: rgb(97, 97, 97);
    -unity-text-align: upper-center;
    margin-bottom: 8px;
}

/* Stretched by .top-content rather than width: 100%, which adds the theme's side margins and was cut at the right. */
.top-button {
    height: 46px;
    border-radius: 10px;
    border-width: 0;
    background-color: rgb(33, 150, 243);
    color: white;
    -unity-text-align: middle-center;
}

.top-button-secondary {
    background-color: rgb(76, 175, 80);
}