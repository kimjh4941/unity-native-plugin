.ios-clipboard-root {
    /* The colour of the safe-area padding (IosSampleSafeArea): that of the header and the list, not this black. */
    --ios-sample-inset-color: rgb(255, 255, 255);
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 1);
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
}

/*
 * The explanatory text lives in the scrolling About section, and the result has a fixed height, so the header
 * stays short. It is not capped at half the screen any more: on an iPhone 13 mini the title and the status line
 * wrap and the cap pushed the status line out of the header (2026-11-22).
 */
.ios-clipboard-header {
    background-color: rgba(255, 255, 255, 1);
    padding: 12px 16px;
    gap: 6px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
}

.ios-clipboard-title {
    font-size: 20px;
    color: #1C1C1E;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    white-space: normal;
}

/*
 * Fixed height: results are single lines, but a long native error message wraps. Letting the
 * result area grow would push the button list off screen, so the text scrolls inside instead.
 * flex-shrink: 0 keeps the header from compressing it.
 */
.ios-clipboard-result-border {
    background-color: #EEEEEE;
    border-radius: 8px;
    height: 64px;
    flex-shrink: 0;
}

.ios-clipboard-result-scroll {
    flex-grow: 1;
}

.ios-clipboard-result-text {
    padding: 10px;
    font-size: 12px;
    color: #212121;
    -unity-text-align: upper-left;
    white-space: normal;
}

.ios-clipboard-status-text {
    font-size: 12px;
    color: #1C1C1E;
    -unity-font-style: bold;
    -unity-text-align: upper-left;
    white-space: normal;
}

/* The rest of the screen below the header (no floor: with the header uncapped, half the screen as a floor pushed
   the list past the bottom of the screen on an iPhone 13 mini, 2026-11-22). */
.ios-clipboard-scroll {
    flex-grow: 1;
}

.ios-clipboard-content {
    background-color: rgba(255, 255, 255, 1);
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 0 16px 16px 16px;
    gap: 12px;
}

.ios-clipboard-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.ios-clipboard-section-title {
    font-size: 15px;
    color: #263238;
    -unity-font-style: bold;
    white-space: normal;
}

.ios-clipboard-section-note {
    font-size: 11px;
    color: #757575;
    white-space: normal;
}

.ios-clipboard-button {
    background-color: #007AFF;
    color: white;
    font-size: 14px;
    width: 100%;
    min-height: 46px;
    height: auto;
    -unity-text-align: middle-center;
    border-width: 0;
    border-radius: 8px;
    white-space: normal;
    overflow: visible;
    padding: 8px 12px;
}

.ios-clipboard-button:hover {
    background-color: #0056D6;
}

.ios-clipboard-button:active {
    background-color: #0046AA;
}

.ios-clipboard-button:disabled {
    background-color: #CCCCCC;
    color: #999999;
}

.ios-secondary-button {
    background-color: #8E8E93;
    color: white;
    font-size: 14px;
    width: 100%;
    min-height: 46px;
    height: auto;
    -unity-text-align: middle-center;
    border-width: 0;
    border-radius: 8px;
    white-space: normal;
    overflow: visible;
    padding: 8px 12px;
}

.ios-secondary-button:hover {
    background-color: #6E6E73;
}

.ios-secondary-button:active {
    background-color: #5A5A5E;
}

.ios-secondary-button:disabled {
    background-color: #CCCCCC;
    color: #999999;
}

/*
 * Landscape (IosSampleSafeArea puts .ios-sample-landscape on the root while the screen is wider than tall;
 * UI Toolkit has no media queries). The portrait header would take almost the whole height and leave the
 * button list less than a button tall, so the header becomes one row - the Home button, then the result -
 * and the title and the description are hidden. The result box is 52 tall and its text scrolls inside.
 */
.ios-sample-landscape .ios-clipboard-header {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    padding-top: 8px;
    padding-bottom: 8px;
}

.ios-sample-landscape .ios-clipboard-title {
    display: none;
}

.ios-sample-landscape #HomeButton {
    width: 30%;
    flex-shrink: 0;
}

/* Basis 0, so a long result never pushes the box onto the next line (sample plan v3, R3-1). */
.ios-sample-landscape .ios-clipboard-result-border {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    height: 52px;
}

/* The status line takes the second row. */
.ios-sample-landscape #StatusTextBlock {
    width: 100%;
}
