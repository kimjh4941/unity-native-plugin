/* iOS Safe Area対応USS */
:root {
}

.ios-safe-area-container {
    /* The colour of the safe-area padding (IosSampleSafeArea): that of the header and the list, not this black. */
    --ios-sample-inset-color: rgb(255, 255, 255);
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 1);
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
}

.ios-dialog-header {
    background-color: rgba(255, 255, 255, 1);
    padding: 16px;
    gap: 0;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
}

.ios-scroll {
    flex-grow: 1;
}

/*
 * At least 46 tall and taller when the text wraps (as the Clipboard screen's buttons): in landscape the Home
 * button is 30% wide and its two lines were cut at a fixed 46 on an iPhone 13 mini (2026-11-22).
 */
.ios-dialog-secondary-button {
    background-color: #8E8E93;
    color: white;
    font-size: 14px;
    min-height: 46px;
    height: auto;
    -unity-text-align: middle-center;
    border-width: 0;
    border-radius: 10px;
    margin-bottom: 10px;
    white-space: normal;
}

.ios-dialog-content {
    flex-grow: 1;
    background-color: rgba(248, 248, 248, 1); /* iOS風の背景色 */
    border-radius: 0px; /* iOS風の大きめの角丸 */
    padding: 0px;
    margin: 0px;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
}

.ios-dialog-title {
    font-size: 20px;
    color: #1C1C1E; /* iOS風のダークテキスト */
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: 20px;
    white-space: normal;
}

/* ListView専用スタイル */

/*
 * Fixed height, and the text scrolls inside (as on the Clipboard screen): a long result grew the header until
 * the button list below was squashed to nothing on an iPhone 13 mini (2026-11-22).
 */
.ios-result-border {
    background-color: #E9E9EB; /* iOS風のグレー */
    border-radius: 12px;
    margin: 10px 0 20px 0;
    height: 64px;
    flex-shrink: 0;
}

.ios-result-scroll {
    flex-grow: 1;
}

.ios-result-text {
    padding: 10px;
    font-size: 12px;
    color: #1C1C1E;
    -unity-text-align: upper-center;
    white-space: normal;
}

/*
 * The text wraps and the button grows (as the Clipboard screen's buttons): "ShowDestructiveDialog" did not fit
 * in one line on an iPhone 16 and three of the names did not on a 13 mini (2026-11-22).
 */
.ios-dialog-button {
    background-color: #007AFF; /* iOSシステムブルー */
    color: white;
    font-size: 14px;
    min-height: 46px;
    height: auto;
    white-space: normal;
    -unity-text-align: middle-center;
    border-width: 0;
    border-radius: 10px;
    margin-bottom: 10px;
}

.ios-dialog-button:hover {
    background-color: #0056D6;
}

.ios-dialog-button:active {
    background-color: #0046AA;
}

.ios-dialog-button:disabled {
    background-color: #CCCCCC;
    color: #999999;
}

/* 画面サイズ別スタイル - iOS風 */
.small-screen .ios-dialog-content {
    margin: 0px;
    padding: 12px;
}

.small-screen .ios-dialog-title {
    font-size: 14px;
    margin-bottom: 16px;
}

.medium-screen .ios-dialog-content {
    margin: 0px;
    padding: 16px;
}

.medium-screen .ios-dialog-title {
    font-size: 20px;
}

.large-screen .ios-dialog-content {
    margin: 0px;
    padding: 20px;
    align-self: center;
}

.large-screen .ios-dialog-title {
    font-size: 20px;
}

/* DPI別スタイル調整 */
.low-dpi .ios-dialog-title {
    font-size: 14px;
}

.medium-dpi .ios-dialog-title {
    font-size: 16px;
}

.high-dpi .ios-dialog-title {
    font-size: 18px;
}

/*
 * Landscape (IosSampleSafeArea puts .ios-sample-landscape on the root while the screen is wider than tall;
 * UI Toolkit has no media queries). The portrait header would take almost the whole height and leave the
 * button list less than a button tall, so the header becomes one row - the Home button, then the result -
 * and the title and the description are hidden. The result box is 52 tall and its text scrolls inside.
 */
.ios-sample-landscape .ios-dialog-header {
    flex-direction: row;
    align-items: flex-start;
    padding-top: 8px;
    padding-bottom: 8px;
}

.ios-sample-landscape .ios-dialog-title {
    display: none;
}

.ios-sample-landscape #HomeButton {
    width: 30%;
    flex-shrink: 0;
    margin: 0 12px 0 0;
}

.ios-sample-landscape .ios-dialog-header > .ios-result-border {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    height: 52px;
    margin: 0;
}
