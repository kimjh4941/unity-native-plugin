<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="IosShareManagerExampleStyle.uss" />
    <ui:VisualElement class="ios-share-root">
        <ui:VisualElement class="ios-share-header">
            <ui:Button name="HomeButton" class="ios-secondary-button" text="Back To Home" />
            <ui:Label text="IosShareManager Example" class="ios-share-title" />
            <ui:Label text="Present the iOS system share sheet for text, URL, image, and file content." class="ios-share-subtitle" />
            <ui:VisualElement class="ios-share-result-border">
                <ui:Label name="ResultTextBlock" text="iOS share sample ready. Run on an iOS device to test sharing." class="ios-share-result-text" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ScrollView class="ios-share-scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden">
            <ui:VisualElement class="ios-share-content">

                <ui:VisualElement class="ios-share-section">
                    <ui:Label text="Text" class="ios-share-section-title" />
                    <ui:Button name="ShareTextButton" class="ios-share-button" text="Share Text" />
                </ui:VisualElement>

                <ui:VisualElement class="ios-share-section">
                    <ui:Label text="URL" class="ios-share-section-title" />
                    <ui:Button name="ShareUrlButton" class="ios-share-button" text="Share URL" />
                    <ui:Button name="ShareUrlPreviewButton" class="ios-share-button" text="Share URL with Preview" />
                </ui:VisualElement>

                <ui:VisualElement class="ios-share-section">
                    <ui:Label text="Image" class="ios-share-section-title" />
                    <ui:Button name="ShareImageButton" class="ios-share-button" text="Share Image" />
                    <ui:Button name="ShareImagesButton" class="ios-share-button" text="Share Multiple Images" />
                </ui:VisualElement>

                <ui:VisualElement class="ios-share-section">
                    <ui:Label text="File" class="ios-share-section-title" />
                    <ui:Button name="ShareFileButton" class="ios-share-button" text="Share File" />
                    <ui:Button name="ShareFilesButton" class="ios-share-button" text="Share Multiple Files" />
                </ui:VisualElement>

                <ui:VisualElement class="ios-share-section">
                    <ui:Label text="Combination" class="ios-share-section-title" />
                    <ui:Button name="ShareMultipleButton" class="ios-share-button" text="Share Text + URL" />
                    <ui:Button name="ShareWithSubjectButton" class="ios-share-button" text="Share with Subject" />
                    <ui:Button name="ShareExcludingActivitiesButton" class="ios-share-button" text="Share Excluding Activities" />
                </ui:VisualElement>

                <ui:VisualElement class="ios-share-section">
                    <ui:Label text="Error Handling" class="ios-share-section-title" />
                    <ui:Button name="ShareEmptyButton" class="ios-secondary-button" text="Share Empty (error)" />
                    <ui:Button name="ShareInvalidUrlButton" class="ios-secondary-button" text="Share Invalid URL" />
                    <ui:Button name="ShareMissingFileButton" class="ios-secondary-button" text="Share Missing File" />
                    <ui:Button name="ShareMissingImageButton" class="ios-secondary-button" text="Share Missing Image" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
