.ios-notif-root {
    /* The colour of the safe-area padding (IosSampleSafeArea): that of the header and the list, not this black. */
    --ios-sample-inset-color: rgb(255, 255, 255);
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 1);
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
}

.ios-notif-header {
    background-color: rgba(255, 255, 255, 1);
    padding: 16px;
    gap: 12px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
}

.ios-notif-title {
    font-size: 20px;
    color: #1C1C1E;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-top: 8px;
    margin-bottom: 4px;
    white-space: normal;
}

.ios-notif-subtitle {
    font-size: 12px;
    color: #8E8E93;
    -unity-text-align: upper-center;
    margin-bottom: 8px;
    white-space: normal;
}

/*
 * Fixed height, and the text scrolls inside (as on the Clipboard screen): a long result grew the header until
 * the button list below was squashed to nothing on an iPhone 13 mini (2026-11-22).
 */
.ios-result-border {
    background-color: #EEEEEE;
    border-radius: 8px;
    height: 64px;
    flex-shrink: 0;
}

.ios-result-scroll {
    flex-grow: 1;
}

.ios-result-text {
    padding: 10px;
    font-size: 12px;
    color: #212121;
    -unity-text-align: upper-left;
    white-space: normal;
}

.ios-notif-scroll {
    flex-grow: 1;
}

.ios-notif-content {
    background-color: rgba(255, 255, 255, 1);
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 0 16px 16px 16px;
    gap: 12px;
}

.ios-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.ios-section-title {
    font-size: 15px;
    color: #263238;
    -unity-font-style: bold;
    white-space: normal;
}

.ios-notif-button {
    background-color: #007AFF;
    color: white;
    font-size: 14px;
    width: 100%;
    min-height: 46px;
    height: auto;
    -unity-text-align: middle-center;
    border-width: 0;
    border-radius: 8px;
    white-space: normal;
    overflow: visible;
    padding: 8px 12px;
}

.ios-notif-button:hover {
    background-color: #0056D6;
}

.ios-notif-button:active {
    background-color: #0046AA;
}

.ios-notif-button:disabled {
    background-color: #CCCCCC;
    color: #999999;
}

.ios-secondary-button {
    background-color: #8E8E93;
    color: white;
    font-size: 14px;
    width: 100%;
    min-height: 46px;
    height: auto;
    -unity-text-align: middle-center;
    border-width: 0;
    border-radius: 8px;
    white-space: normal;
    overflow: visible;
    padding: 8px 12px;
}

.ios-secondary-button:hover {
    background-color: #6E6E73;
}

.ios-secondary-button:active {
    background-color: #5A5A5E;
}

/*
 * Landscape (IosSampleSafeArea puts .ios-sample-landscape on the root while the screen is wider than tall;
 * UI Toolkit has no media queries). The portrait header would take almost the whole height and leave the
 * button list less than a button tall, so the header becomes one row - the Home button, then the result -
 * and the title and the description are hidden. The result box is 52 tall and its text scrolls inside.
 */
.ios-sample-landscape .ios-notif-header {
    flex-direction: row;
    align-items: flex-start;
    padding-top: 8px;
    padding-bottom: 8px;
}

.ios-sample-landscape .ios-notif-title,
.ios-sample-landscape .ios-notif-subtitle {
    display: none;
}

.ios-sample-landscape #HomeButton {
    width: 30%;
    flex-shrink: 0;
}

.ios-sample-landscape .ios-notif-header > .ios-result-border {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    height: 52px;
}
